{
  "name": "luma-vault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:deps": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1175.0",
    "aws-amplify": "6.22.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@aws-amplify/backend": "1.25.1",
    "@aws-amplify/backend-cli": "1.10.0",
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "aws-cdk-lib": "2.278.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  },
  "overrides": {
    "@aws-amplify/graphql-docs-generator": {
      "handlebars": "4.7.10"
    },
    "@ardatan/relay-compiler": {
      "immutable": "3.8.4"
    },
    "@graphql-codegen/plugin-helpers": {
      "lodash": "4.18.1"
    },
    "@graphql-codegen/visitor-plugin-common": {
      "lodash": "4.18.1"
    }
  }
}
